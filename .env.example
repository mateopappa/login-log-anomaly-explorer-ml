# Copy to .env and adjust. Never commit real secrets.

# Postgres (Docker Compose default)
DATABASE_URL=postgresql+psycopg://login:login@postgres:5432/login_anomaly

# Local SQLite alternative for API without Docker:
# DATABASE_URL=sqlite+pysqlite:///./data/login_anomaly.db

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Investigator: mock (default) or haiku
INVESTIGATOR_DEFAULT=mock

# Optional — leave empty to keep the mock baseline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional multi-site pipeline (docker compose --profile pipeline)
# KAFKA_BOOTSTRAP=localhost:19092
# GRAFANA_URL=http://localhost:3000
# PROMETHEUS_URL=http://localhost:9090
# REDPANDA_CONSOLE_URL=http://localhost:8081
# WORKER_METRICS_URL=http://localhost:9100/metrics
